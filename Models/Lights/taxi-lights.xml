<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <!-- Compositor lights -->

    <light>
        <name>taxi-light-left</name>
        <type>spot</type>
        <position>
            <x-m> -8.0</x-m>
            <y-m>-0.07</y-m>
            <z-m> -1.3</z-m>
        </position>
        <direction>
            <x>-1.0</x>
            <y> -0.1</y>
            <z> 0.0</z>
        </direction>
        <ambient>
            <r>0.01</r>
            <g>0.009</g>
            <b>0.009</b>
            <a>0</a>
        </ambient>
        <diffuse>
            <r>0.01</r>
            <g>0.009</g>
            <b>0.009</b>
            <a>0</a>
        </diffuse>
        <specular>
            <r>0.02</r>
            <g>0.019</g>
            <b>0.019</b>
            <a>0</a>
        </specular>
        <dim-factor>
            <property>systems/electrical/right-main-bus-volts</property>
        </dim-factor>
        <attenuation>
            <c>0.25</c>
            <l>0.0225</l>
            <q>0.000001875</q>
        </attenuation>
        <spot-cutoff>10</spot-cutoff>
        <spot-exponent>20</spot-exponent>
        <range-m>100</range-m>
    </light>

    <light>
        <name>taxi-light-right</name>
        <type>spot</type>
        <position>
            <x-m> -8.0</x-m>
            <y-m>0.07</y-m>
            <z-m>-1.3</z-m>
        </position>
        <direction>
            <x>-1.0</x>
            <y> 0.1</y>
            <z> 0.0</z>
        </direction>
        <ambient>
            <r>0.01</r>
            <g>0.009</g>
            <b>0.009</b>
            <a>0</a>
        </ambient>
        <diffuse>
            <r>0.01</r>
            <g>0.009</g>
            <b>0.009</b>
            <a>0</a>
        </diffuse>
        <specular>
            <r>0.02</r>
            <g>0.019</g>
            <b>0.019</b>
            <a>0</a>
        </specular>
        <dim-factor>
            <property>systems/electrical/right-main-bus-volts</property>
        </dim-factor>
        <attenuation>
            <c>0.25</c>
            <l>0.0225</l>
            <q>0.000001875</q>
        </attenuation>
        <spot-cutoff>10</spot-cutoff>
        <spot-exponent>20</spot-exponent>
        <range-m>100</range-m>
    </light>

    <animation>
        <type>select</type>
        <object-name>taxi-light-left</object-name>
        <object-name>taxi-light-right</object-name>
        <condition>
          <and>
            <property>controls/lighting/taxi-light</property>
            <greater-than>
              <property>gear/gear[0]/position-norm</property>
              <value>0.2</value>
            </greater-than>
          </and>
        </condition>
    </animation>

    <animation>
        <type>rotate</type>
          <object-name>taxi-light-left</object-name>
          <object-name>taxi-light-right</object-name>
        <property>controls/gear/steering</property>
        <factor>100</factor>
        <center>
            <x-m>-8.149</x-m>
            <y-m>0</y-m>
            <z-m>-1.593</z-m>
        </center>
        <axis>
            <x>0</x>
            <y>0</y>
            <z>1</z>
        </axis>
    </animation>

</PropertyList>
